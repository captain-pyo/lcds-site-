---
layout: base.njk
title: 문의
permalink: /contact/
---
<section class="block tight" style="background:var(--navy-deep); color:#fff;">
  <div class="wrap">
    <div class="eyebrow">Contact</div>
    <h1 style="color:#fff;">문의하기</h1>
  </div>
</section>

<section class="block">
  <div class="wrap contact-grid">
    <div>
      <ul class="contact-list">
        <li><span class="label">Email</span><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        <li><span class="label">Phone</span>{{ contact.phone }}</li>
        <li><span class="label">Blog</span><a href="{{ contact.blog }}" target="_blank" rel="noopener">{{ contact.blog }}</a></li>
        <li><span class="label">Facebook</span><a href="{{ contact.facebook }}" target="_blank" rel="noopener">{{ contact.facebook }}</a></li>
        <li><span class="label">Youtube</span><a href="{{ contact.youtube }}" target="_blank" rel="noopener">{{ contact.youtube }}</a></li>
        <li><span class="label">Band</span>{{ contact.band }}</li>
      </ul>
    </div>
    <div>
      <form class="inquiry" name="inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="inquiry">
        <p style="display:none;"><label>이 항목을 비워두세요: <input name="bot-field"></label></p>
        <div>
          <label for="name">이름</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="email">이메일</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div>
          <label for="message">문의 내용</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button type="submit">보내기</button>
      </form>
    </div>
  </div>
</section>
