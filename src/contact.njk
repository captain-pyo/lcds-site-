---
layout: base.njk
title: 문의
permalink: /contact/
---
<section class="block tight" style="background:var(--navy-deep); color:#fff;">
  <div class="wrap">
    <div class="eyebrow">Contact</div>
    <h1 style="color:#fff;">무료 상담 신청 · 문의하기</h1>
    <p style="color:rgba(255,255,255,0.75); max-width:52ch;">부담 없이 첫 걸음을 떼어보세요. 이메일 상담과 15분 전화 상담 중 편하신 방식을 선택하실 수 있습니다.</p>
  </div>
</section>

<section class="block">
  <div class="wrap contact-grid">
    <div>
      <ul class="contact-list">
        <li><span class="label">Email</span><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        <li><span class="label">Phone</span>{{ contact.phone }}</li>
        <li><span class="label">Blog</span><a href="{{ contact.blog }}" target="_blank" rel="noopener">{{ contact.blog }}</a></li>
        <li><span class="label">Facebook</span><a href="{{ contact.facebook }}" target="_blank" rel="noopener">{{ contact.facebook }}</a></li>
        <li><span class="label">Youtube</span><a href="{{ contact.youtube }}" target="_blank" rel="noopener">{{ contact.youtube }}</a></li>
        <li><span class="label">Band</span>{{ contact.band }}</li>
      </ul>
    </div>
    <div>
      <form class="inquiry" name="inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" onsubmit="return checkContactInfo(this)">
        <input type="hidden" name="form-name" value="inquiry">
        <p style="display:none;"><label>이 항목을 비워두세요: <input name="bot-field"></label></p>

        <div class="consult-type">
          <label class="consult-option">
            <input type="radio" name="consult_type" value="이메일 상담" checked>
            <span>
              <strong>이메일 상담</strong>
              <small>신청서를 검토하고 이메일로 답변드립니다</small>
            </span>
          </label>
          <label class="consult-option">
            <input type="radio" name="consult_type" value="15분 전화 상담">
            <span>
              <strong>15분 전화 상담</strong>
              <small>일정을 조율해 짧은 통화로 상황을 파악합니다</small>
            </span>
          </label>
        </div>

        <div>
          <label for="name">이름</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="email" id="email-label">이메일</label>
          <input type="email" id="email" name="email">
        </div>
        <div>
          <label for="phone" id="phone-label">전화번호</label>
          <input type="tel" id="phone" name="phone" placeholder="010-0000-0000">
        </div>
        <div>
          <label for="message">문의 내용</label>
          <textarea id="message" name="message" required placeholder="현재 상황이나 궁금하신 점을 간단히 적어주시면 상담에 도움이 됩니다."></textarea>
        </div>
        <button type="submit">신청하기</button>
      </form>
      <script>
        function checkContactInfo(form) {
          const type = form.consult_type.value;
          const email = form.email.value.trim();
          const phone = form.phone.value.trim();
          if (type === '15분 전화 상담') {
            if (!phone) {
              alert('전화 상담을 선택하셨습니다. 전화번호를 입력해 주세요.');
              return false;
            }
          } else {
            if (!email) {
              alert('이메일 상담을 선택하셨습니다. 이메일 주소를 입력해 주세요.');
              return false;
            }
          }
          return true;
        }
        document.querySelectorAll('input[name="consult_type"]').forEach(function (radio) {
          radio.addEventListener('change', function () {
            const isPhone = this.value === '15분 전화 상담';
            document.getElementById('email-label').textContent = isPhone ? '이메일 (선택)' : '이메일';
            document.getElementById('phone-label').textContent = isPhone ? '전화번호' : '전화번호 (선택)';
          });
        });
      </script>
    </div>
  </div>
</section>
