---
layout: base.njk
title: 콘텐츠 제작
permalink: /content/
---
{% macro catIcon(icon) %}
  {% if icon == "compass" %}
  <svg viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="14.5,9.5 12,15 9.5,14.5 12,9" fill="#C9A84C" stroke="none"/></svg>
  {% elif icon == "wave" %}
  <svg viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15c2 0 2-4 4-4s2 4 4 4 2-4 4-4 2 4 4 4 2-4 4-4"/><circle cx="12" cy="7" r="1.6" fill="#C9A84C" stroke="none"/></svg>
  {% elif icon == "route" %}
  <svg viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19c4-1 5-6 9-6s3-6 7-8"/><circle cx="4" cy="19" r="1.4" fill="#C9A84C" stroke="none"/><circle cx="20" cy="5" r="1.4" fill="#C9A84C" stroke="none"/></svg>
  {% else %}
  <svg viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
  {% endif %}
{% endmacro %}

<section class="block tight" style="background:var(--navy-deep); color:#fff;">
  <div class="wrap">
    <div class="eyebrow">Content Production</div>
    <h1 style="color:#fff;">콘텐츠 제작 및 제공</h1>
    <p style="color:rgba(255,255,255,0.75); max-width:52ch;">{{ content_library.intro }}</p>
  </div>
</section>

<section class="block tight">
  <div class="wrap">
    <div class="stats" style="grid-template-columns: repeat(2, 1fr);">
      <div class="stat-card compact">
        <div class="stat-num">{{ content_library.package_count }}</div>
        <div class="stat-label">패키지 — 시리즈·과정형, 10시간 이상</div>
      </div>
      <div class="stat-card compact">
        <div class="stat-num">{{ content_library.module_count }}</div>
        <div class="stat-label">모듈 — 단일주제형, 1~3시간 이내</div>
      </div>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="grid-2">
      {% for cat in content_library.categories %}
      <div class="card cat-card">
        <div class="icon-circle">{{ catIcon(cat.icon) }}</div>
        <h3>{{ cat.name }}</h3>
        <ul>
          {% for t in cat.topics %}
          <li>{{ t }}</li>
          {% endfor %}
        </ul>
        <span class="lib-note">이 외에도 다수 보유 중입니다</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="block alt">
  <div class="wrap contact-grid">
    <div>
      <div class="eyebrow">Request</div>
      <h2>콘텐츠 제작 문의</h2>
      <p style="color:var(--muted); max-width:44ch;">희망하시는 콘텐츠 종류와 형태를 알려주시면, 보유 라이브러리를 바탕으로 맞춤 편성 방안을 상담해드립니다.</p>
    </div>
    <div>
      <form class="inquiry" name="content-request" method="POST" data-netlify="true" netlify-honeypot="bot-field" onsubmit="return checkContentForm(this)">
        <input type="hidden" name="form-name" value="content-request">
        <p style="display:none;"><label>이 항목을 비워두세요: <input name="bot-field"></label></p>

        <div class="field-group">
          <label for="content_kind">콘텐츠 종류</label>
          <select id="content_kind" name="content_kind" required>
            <option value="">선택해 주세요</option>
            {% for cat in content_library.categories %}
            <option value="{{ cat.name }}">{{ cat.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="consult-type">
          <label class="consult-option">
            <input type="radio" name="format_type" value="패키지" checked>
            <span>
              <strong>패키지</strong>
              <small>시리즈·과정형, 10시간 이상</small>
            </span>
          </label>
          <label class="consult-option">
            <input type="radio" name="format_type" value="모듈">
            <span>
              <strong>모듈</strong>
              <small>단일주제형, 1~3시간 이내</small>
            </span>
          </label>
        </div>

        <div>
          <label for="name">이름</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="email">이메일</label>
          <input type="email" id="email" name="email">
        </div>
        <div>
          <label for="phone">전화번호</label>
          <input type="tel" id="phone" name="phone" placeholder="010-0000-0000">
        </div>
        <div>
          <label for="message">세부 내용</label>
          <textarea id="message" name="message" required placeholder="희망 주제, 활용 목적, 대상 등을 적어주시면 상담에 도움이 됩니다."></textarea>
        </div>
        <button type="submit">콘텐츠 제작 문의하기</button>
      </form>
      <script>
        function checkContentForm(form) {
          if (!form.email.value.trim() && !form.phone.value.trim()) {
            alert('이메일 또는 전화번호 중 하나는 입력해 주세요.');
            return false;
          }
          return true;
        }
      </script>
    </div>
  </div>
</section>
