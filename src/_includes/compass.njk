<svg class="compass" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <radialGradient id="compassGlow" cx="50%" cy="50%" r="50%">
      <stop offset="60%" stop-color="#C9A84C" stop-opacity="0.10"/>
      <stop offset="100%" stop-color="#C9A84C" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="needleGold" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#E4D3A0"/>
      <stop offset="100%" stop-color="#C9A84C"/>
    </linearGradient>
  </defs>
  <circle cx="200" cy="200" r="196" fill="url(#compassGlow)"/>
  <circle cx="200" cy="200" r="190" fill="none" stroke="#C9A84C" stroke-width="1.5"/>
  <circle cx="200" cy="200" r="170" fill="none" stroke="#C9A84C" stroke-width="0.75" stroke-dasharray="1 4"/>
  <circle cx="200" cy="200" r="150" fill="none" stroke="#C9A84C" stroke-width="1"/>
  {% for i in range(0, 360, 5) %}
  <line x1="200" y1="10" x2="200" y2="{{ 10 if i % 90 == 0 else (20 if i % 15 == 0 else 26) }}" stroke="#C9A84C" stroke-width="{{ 1.4 if i % 90 == 0 else (1 if i % 15 == 0 else 0.6) }}" transform="rotate({{ i }} 200 200)"/>
  {% endfor %}
  <circle cx="200" cy="200" r="4" fill="#C9A84C"/>
  <circle cx="200" cy="200" r="8" fill="none" stroke="#C9A84C" stroke-width="1"/>
  <polygon points="200,36 214,200 200,222 186,200" fill="url(#needleGold)"/>
  <polygon points="200,364 186,200 200,178 214,200" fill="none" stroke="#C9A84C" stroke-width="1"/>
  <text x="200" y="30" text-anchor="middle" fill="#E4D3A0" font-size="18" font-weight="700" font-family="serif">N</text>
  <text x="200" y="382" text-anchor="middle" fill="#C9A84C" font-size="14" font-family="serif">S</text>
  <text x="384" y="206" text-anchor="middle" fill="#C9A84C" font-size="14" font-family="serif">E</text>
  <text x="16" y="206" text-anchor="middle" fill="#C9A84C" font-size="14" font-family="serif">W</text>
  <text x="317" y="90" text-anchor="middle" fill="#C9A84C" font-size="10" font-family="serif" opacity="0.8">NE</text>
  <text x="317" y="318" text-anchor="middle" fill="#C9A84C" font-size="10" font-family="serif" opacity="0.8">SE</text>
  <text x="83" y="318" text-anchor="middle" fill="#C9A84C" font-size="10" font-family="serif" opacity="0.8">SW</text>
  <text x="83" y="90" text-anchor="middle" fill="#C9A84C" font-size="10" font-family="serif" opacity="0.8">NW</text>
</svg>
