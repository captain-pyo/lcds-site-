<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · {{ site.name_kr }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<meta name="naver-site-verification" content="07e2c409c60a774b545bfa2c592f7d979776f7e8" />
<link rel="stylesheet" href="/css/style.css">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-4Q5Q9W18HO"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-4Q5Q9W18HO');
</script>

<style>
  .kakao-float-btn {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: #FEE500;
    color: #191919;
    padding: 12px 18px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    font-family: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .kakao-float-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
  }
  .kakao-float-btn svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .kakao-float-btn {
      right: 14px;
      bottom: 14px;
      padding: 12px 14px;
    }
    .kakao-float-btn .kakao-float-label {
      display: none;
    }
  }
</style>
</head>
<body>
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}

<a href="https://open.kakao.com/o/sdaaZxJi" target="_blank" rel="noopener" class="kakao-float-btn" aria-label="카카오톡으로 상담 문의하기">
  <svg viewBox="0 0 24 24" fill="#191919" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3C6.477 3 2 6.463 2 10.74c0 2.723 1.83 5.12 4.59 6.49-.2.75-.73 2.73-.84 3.15-.13.52.19.51.4.37.16-.11 2.6-1.77 3.66-2.49.71.1 1.44.16 2.19.16 5.523 0 10-3.463 10-7.74C22 6.463 17.523 3 12 3z"/>
  </svg>
  <span class="kakao-float-label">카톡 상담</span>
</a>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.main-nav');
  if (toggle) {
    toggle.addEventListener('click', () => nav.classList.toggle('open'));
  }
</script>
</body>
</html>
